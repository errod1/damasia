<!DOCTYPE html>
<html>
<head>
    <title>Partida de Damas {{ game.id }}</title>
    <style>
        body { font-family: sans-serif; display: flex; flex-direction: column; align-items: center;}
        .board { border-collapse: collapse; border: 2px solid black; margin-top: 20px; }
        .board td {
            width: 50px;
            height: 50px;
            border: 1px solid #ccc;
            text-align: center;
            vertical-align: middle;
            font-size: 24px;
            position: relative; /* Para posicionar las piezas */
        }
        .square-dark { background-color: #769656; /* Verde oscuro */ }
        .square-light { background-color: #eeeed2; /* Beige claro */ }

        .piece {
            width: 80%;
            height: 80%;
            border-radius: 50%;
            position: absolute;
            top: 10%;
            left: 10%;
            box-sizing: border-box;
            border: 2px solid black; /* Borde para todas */
        }
        .p1.man { background-color: #B80000; } /* Rojo oscuro para P1 */
        .p1.king { background-color: #FF4C4C; border: 3px solid gold; } /* Rojo más claro + borde rey */
        .p2.man { background-color: #E0E0E0; } /* Gris claro para P2 */
        .p2.king { background-color: #FFFFFF; border: 3px solid gold; } /* Blanco + borde rey */

        .info { margin-top: 15px; }
        .status-ongoing { color: blue; }
        .status-win { color: green; font-weight: bold; }
        .status-lose { color: red; font-weight: bold; }
    </style>
</head>
<body>
    <h1>Partida de Damas #{{ game.id }}</h1>

    <div class="info">
        Turno del Jugador: {{ game.current_turn }}
        <br>
        Estado:
        {% if game.status == 0 %} <span class="status-ongoing">{{ game.get_status_display }}</span>
        {% elif game.status == 1 %} <span class="status-win">{{ game.get_status_display }}</span>
        {% elif game.status == 2 %} <span class="status-win">{{ game.get_status_display }}</span>
        {% else %} <span>{{ game.get_status_display }}</span>
        {% endif %}
         <br>
         Jugador 1: {{ game.get_player1_type_display }} | Jugador 2: {{ game.get_player2_type_display }}
    </div>

    <table class="board">
        {% for r in rows %}
        <tr>
            {% for c in cols %}
                {% with piece=board|slice:r|first|slice:c|first %} {# Acceso seguro al elemento #}
                {% with is_dark=r|add:c|divisibleby:2 %} {# Determinar si la casilla es oscura #}
                    <td class="{% if is_dark %}square-dark{% else %}square-light{% endif %}"
                        data-row="{{ r }}" data-col="{{ c }}">

                        {% if piece == P1_MAN %}
                            <div class="piece p1 man"></div>
                        {% elif piece == P1_KING %}
                            <div class="piece p1 king"></div>
                        {% elif piece == P2_MAN %}
                            <div class="piece p2 man"></div>
                        {% elif piece == P2_KING %}
                            <div class="piece p2 king"></div>
                        {% endif %}
                        {# {% if piece != EMPTY %}{{ piece }}{% endif %} #} {# Mostrar número (opcional para debug) #}
                    </td>
                {% endwith %}
                {% endwith %}
            {% endfor %}
        </tr>
        {% endfor %}
    </table>

    <div class="info">
         <!-- Aquí irán los controles o mensajes para hacer movimientos -->
         <p>Próximamente: ¡Haz clic para mover!</p>
         <!-- Formulario simple para probar la vista make_move (se reemplazará con JS) -->
         <form action="{% url 'game:make_move' game_id=game.id %}" method="post" style="margin-top: 20px;">
             {% csrf_token %}
             <input type="hidden" name="dummy_data" value="test">
             <button type="submit">Probar Enviar Movimiento (POST)</button>
         </form>
    </div>

    <p><a href="{% url 'game:index' %}">Volver a la lista</a></p>

</body>
</html>